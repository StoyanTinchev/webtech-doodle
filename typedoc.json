{
  "entryPoints": [
    "./middleware",
    "./models",
    "./controllers",
    "./services",
    "./routes",
    "server.ts"
  ],
  "entryPointStrategy": "expand",
  "out": "docs/typedoc",
  "tsconfig": "tsconfig.json",
  "exclude": [
    "**/*.spec.ts",
    "node_modules"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "hideGenerator": true
}
